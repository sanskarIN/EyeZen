{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EyeZen",
  "version": "1.0.0-rc.1",
  "identifier": "in.sanskar.eyezen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "EyeZen — Your comfort workspace",
      "width": 1200,
      "height": 800,
      "minWidth": 800,
      "minHeight": 580,
      "backgroundColor": "#151c25"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "Utility",
    "shortDescription": "Comfortable, customizable desktop workspace"
  }
}
